TELEGRAM_TOKEN=YOUR_BOT_TOKEN
OWNER_ID=OWNER_TG_ID
LOG_GROUP_ID=GP_ID
# Shared HBTU / Section B / Section C groups: confession, posts and weather ONLY.
CLASS_GROUP_ID=SHARED_GROUP_ID_1,SHARED_GROUP_ID_2,SHARED_GROUP_ID_3
# Private Major Telegram GP IDs: class reminders and Task/Tutorial reminders ONLY.
# Each variable accepts one or more comma-separated IDs per Major.
# Use Telegram group IDs such as -1001234567890. Leave blank if not configured.
CEIT_MAJOR=
EP_MAJOR=
EC_MAJOR=
ARCHI_MAJOR=
MC_MAJOR=
MECH_MAJOR=
CIVIL_MAJOR=
MONGO_URI=MONGO_DB_URL
WEATHER_API_KEY=OPEN_WEATHER_API
SUPER_ADMINS=EC_ID
VIP_USERS=VIP_USER_FOR_UNLIMITED_NICKNAME
# All majors share one Mongo database. Do not enable per-major databases.
USE_MAJOR_DATABASES=false
MONGO_SHARED_DB_NAME=ClassBotDB
